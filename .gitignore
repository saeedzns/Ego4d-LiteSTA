# === Ignore everything at root ===
/*

# === Allow specific folders and files ===
!/.gitignore
!/README.md
!/local_extraction/

# === Ignore all files in thesis folder by default ===
thesis/*

# === Allow only images shown in README ===
!thesis/success_01.jpg
!thesis/failure_01.jpg
!thesis/big_picture_pipeline_diagram.png
# === Ignore everything inside local_extraction ===
local_extraction/*

# === Allow ONLY these specific folders ===
!local_extraction/trackA/
!local_extraction/trackB/
!local_extraction/trackC/
!local_extraction/labels/
!local_extraction/final_scripts/

# === Common patterns to ignore everywhere ===
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# === Ignore all PDF and MD files except README.md ===
*.pdf
*.md
!README.md
